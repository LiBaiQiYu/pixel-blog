# 和风天气 QWeather 配置（复制为 .env.local 后填写，切勿提交私钥）
QWEATHER_API_HOST=your-api-host.qweatherapi.com
QWEATHER_KID=your-credential-kid
QWEATHER_PROJECT_ID=your-project-id
QWEATHER_DEVELOPER_ID=Q12345ABCD
QWEATHER_PRIVATE_KEY_PATH=./ed25519-private.pem
# 云平台（Netlify/Vercel）如果多行私钥被破坏，可用下面这种单行 base64（二选一）：
# QWEATHER_PRIVATE_KEY_BASE64=<对 ed25519-private.pem 文件做 base64 后的单行字符串>
QWEATHER_LAT=31.23
QWEATHER_LON=121.47
QWEATHER_CITY=上海
QWEATHER_TIMEZONE=Asia/Shanghai

# Mapbox 公共访问令牌（画廊预览地图使用，pk. 开头）
VITE_MAPBOX_ACCESS_TOKEN=

# 外部天气接口地址（可选）
# 本机开发留空即可（走 Vite 内置代理 /api/weather）
# 部署到 GitHub Pages 等纯静态托管时，填已部署好的代理完整地址，例如：
# VITE_WEATHER_API_ENDPOINT=https://your-api.vercel.app/api/weather
# VITE_WEATHER_API_ENDPOINT=https://pixel-blog-weather.xxx.workers.dev/api/weather
