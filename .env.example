# 和风天气 QWeather 配置（复制为 .env.local 后填写，切勿提交私钥）
QWEATHER_API_HOST=your-api-host.qweatherapi.com
QWEATHER_KID=your-credential-kid
QWEATHER_PROJECT_ID=your-project-id
QWEATHER_DEVELOPER_ID=Q12345ABCD
QWEATHER_PRIVATE_KEY_PATH=./ed25519-private.pem
# 云平台（Netlify/Vercel）如果多行私钥被破坏，可用下面这种单行 base64（二选一）：
# QWEATHER_PRIVATE_KEY_BASE64=<对 ed25519-private.pem 文件做 base64 后的单行字符串>
QWEATHER_LAT=31.23
QWEATHER_LON=121.47
QWEATHER_CITY=上海
QWEATHER_TIMEZONE=Asia/Shanghai

# Mapbox 公共访问令牌（画廊预览地图使用，pk. 开头）
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# 文章阅读/喜欢统计 API（Cloudflare Worker + D1）
VITE_STATS_API_URL=https://stats.cwa1e.top

# 外部天气接口地址（可选）
# 本机开发留空即可（走 Vite 内置代理 /api/weather）
# 部署到 GitHub Pages 等纯静态托管时，填已部署好的代理完整地址，例如：
# VITE_WEATHER_API_ENDPOINT=https://your-api.vercel.app/api/weather
# VITE_WEATHER_API_ENDPOINT=https://pixel-blog-weather.xxx.workers.dev/api/weather

# Cloudflare R2 gallery storage (server-side only; do not expose secrets)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=gallery
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_CACHE_CONTROL=public, max-age=31536000, immutable

# Public R2 custom domain used by the browser. Leave empty for local /gallery.
VITE_GALLERY_BASE_URL=

# Blog content lives in R2 under blog/<post-id>/post.md with its images.
R2_BLOG_PREFIX=blog
# Public URL base for Markdown image links. Defaults to https://img.cwa1e.top
VITE_BLOG_IMAGE_BASE_URL=https://img.cwa1e.top
# Optional: override the generated index URL
# VITE_BLOG_INDEX_URL=https://img.cwa1e.top/blog/posts.json

# Next.js public variables. VITE_* values above are mapped as fallbacks in next.config.mjs.
NEXT_PUBLIC_STATS_API_URL=https://stats.cwa1e.top
NEXT_PUBLIC_GALLERY_BASE_URL=
NEXT_PUBLIC_BLOG_IMAGE_BASE_URL=https://img.cwa1e.top
# NEXT_PUBLIC_BLOG_INDEX_URL=https://img.cwa1e.top/blog/posts.json
# NEXT_PUBLIC_WEATHER_API_ENDPOINT=

# Optional token for the dev-only Next.js admin at /admin.
# Set this when accessing the admin over LAN.
ADMIN_DEV_TOKEN=
